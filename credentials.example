# Zoho OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# SalesIQ optional chat URL template
# Example: https://salesiq.zoho.com/your-org/livechat/{conversation_id}
SALESIQ_CHAT_URL_TEMPLATE=

# Owner assignment
OWNER_1_NAME=
OWNER_1_ID=
OWNER_1_EMAIL=

# CRM sender identity
SENDER_USER_ID=
SENDER_USER_EMAIL=
SENDER_USER_NAME=

# Optional CC emails
CC_GERENCIA_EMAIL=
CC_ELIAN_EMAIL=

# Runtime
FLASK_DEBUG=false
PORT=3000
